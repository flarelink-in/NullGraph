{
  "name": "null-graph",
  "version": "1.1.1",
  "description": "A direct-to-GPU rendering framework for massive web worlds. Zero scene graph.  Infinite scale.",
  "type": "module",
  "author": "Vikas Kumar Singh",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/core/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/extras/geometry/index.d.ts",
      "import": "./dist/geometry.js"
    },
    "./loaders": {
      "types": "./dist/extras/loaders/index.d.ts",
      "import": "./dist/loaders.js"
    },
    "./materials": {
      "types": "./dist/extras/materials/index.d.ts",
      "import": "./dist/materials.js"
    },
    "./profiler": {
      "types": "./dist/extras/profiler/index.d.ts",
      "import": "./dist/profiler.js"
    },
    "./debug-ui": {
      "types": "./dist/extras/debug-ui/index.d.ts",
      "import": "./dist/debug-ui.js"
    },
    "./cameras": {
      "types": "./dist/extras/cameras/index.d.ts",
      "import": "./dist/cameras.js"
    },
    "./lights": {
      "types": "./dist/extras/lights/index.d.ts",
      "import": "./dist/lights.js"
    },
    "./post": {
      "types": "./dist/extras/post/index.d.ts",
      "import": "./dist/post.js"
    },
    "./visibility": {
      "types": "./dist/extras/visibility/index.d.ts",
      "import": "./dist/visibility.js"
    },
    "./shadows": {
      "types": "./dist/extras/shadows/index.d.ts",
      "import": "./dist/shadows.js"
    },
    "./environment": {
      "types": "./dist/extras/environment/index.d.ts",
      "import": "./dist/environment.js"
    },
    "./picking": {
      "types": "./dist/extras/picking/index.d.ts",
      "import": "./dist/picking.js"
    },
    "./text": {
      "types": "./dist/extras/text/index.d.ts",
      "import": "./dist/text.js"
    },
    "./agents": {
      "types": "./dist/extras/agents/index.d.ts",
      "import": "./dist/agents.js"
    },
    "./inference": {
      "types": "./dist/extras/inference/index.d.ts",
      "import": "./dist/inference.js"
    },
    "./physics": {
      "types": "./dist/extras/physics/index.d.ts",
      "import": "./dist/physics.js"
    },
    "./film": {
      "types": "./dist/extras/film/index.d.ts",
      "import": "./dist/film.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist dist-web-test",
    "build:lib": "node build.js && tsc",
    "yalc:push": "npm run build:lib:prod && yalc push",
    "build:lib:prod": "node build.js --production && tsc",
    "bundle:test-ui": "node -e \"if (!require('fs').existsSync('dist-web-test')) require('fs').mkdirSync('dist-web-test', {recursive: true})\" && esbuild test/javascript/index.js --bundle --outfile=dist-web-test/index.js --platform=browser --format=esm --sourcemap",
    "postbuild:test": "node copy-assets.js",
    "build:test": "npm run clean && npm run build:lib:prod && npm run bundle:test-ui && npm run postbuild:test",
    "dev:serve": "node dev-server.js",
    "dev:serve:nosab": "node dev-server.js --no-sab",
    "test:core": "node test/core-compute.test.mjs && node test/core-headless.test.mjs",
    "test:profiler": "node test/profiler.test.mjs",
    "test:cameras": "node --test test/cameras-input.test.mjs",
    "test:gpu": "node test/gpu/run-gpu-tests.mjs",
    "test:gpu:browser": "node test/gpu/browser-run.mjs",
    "drive": "node test/gpu/drive-page.mjs",
    "agents:record": "node tools/agents/record.mjs",
    "agents:train": "node tools/agents/train.mjs",
    "agents:evaluate": "node tools/agents/evaluate.mjs",
    "agents:export": "node tools/agents/export.mjs",
    "agents:coevolve": "node tools/agents/coevolve.mjs",
    "agents:arena-eval": "node tools/agents/coevolve-eval.mjs baselines",
    "agents:crossplay": "node tools/agents/coevolve-eval.mjs crossplay",
    "agents:site": "node tools/agents/coevolve-site.mjs",
    "spike:s3": "node test/gpu/run-harness.mjs test/spikes/s3-think-kernel/run.js __S3_RESULTS__",
    "spike:mlp-think": "node test/gpu/run-harness.mjs test/spikes/mlp-think-cost/run.js __MLP_THINK_RESULTS__",
    "spike:s6": "node test/gpu/run-harness.mjs test/spikes/genome-rows/run.js __S6_RESULTS__",
    "spike:s7": "node test/gpu/run-harness.mjs test/spikes/coevo/run.js __S7_RESULTS__",
    "spike:s8": "node test/gpu/run-harness.mjs test/spikes/contacts/run.js __S8_RESULTS__",
    "spike:s9": "node test/gpu/run-harness.mjs test/spikes/contact-solver/run.js __S9_RESULTS__",
    "spike:s1": "node test/gpu/run-harness.mjs test/spikes/ort/s1.js __ORT_SPIKE_RESULTS__",
    "spike:s2": "node test/gpu/run-harness.mjs test/spikes/ort/s2.js __ORT_SPIKE_RESULTS__",
    "spike:s4": "node test/gpu/run-harness.mjs test/spikes/ort/s4.js __ORT_SPIKE_RESULTS__",
    "spike:s5": "node test/gpu/run-harness.mjs test/spikes/ort/s5.js __ORT_SPIKE_RESULTS__",
    "spike:ort-issues": "node test/gpu/run-harness.mjs test/spikes/ort/issues.js __ORT_SPIKE_RESULTS__",
    "spike:ort-counts": "node test/gpu/run-harness.mjs test/spikes/ort/counts.js __ORT_SPIKE_RESULTS__",
    "render": "node test/gpu/render.mjs",
    "test:agent-kit": "node --test test/agent-kit.test.mjs",
    "test:post": "node test/post-arena.test.mjs && node test/post-pool.test.mjs && node test/post-shader-gen.test.mjs",
    "test:geometry": "node test/geometry-meshlets.test.mjs",
    "test:loaders": "node --test test/loaders-*.test.mjs",
    "test:visibility": "node test/visibility-cull.test.mjs && node test/material-bridge.test.mjs && node test/visibility-lifecycle.test.mjs && node --test test/visibility-hook.test.mjs test/visibility-lod.test.mjs",
    "test:shadows": "node test/shadows-csm.test.mjs",
    "test:picking": "node test/picking.test.mjs",
    "test:text": "node test/text.test.mjs",
    "test:agents": "node test/agents.test.mjs && node --test test/agents-grid.test.mjs test/agents-system.test.mjs test/agents-arrows.test.mjs test/agents-instances.test.mjs test/agents-inspect.test.mjs test/agents-api-example.test.mjs test/agents-mlp.test.mjs test/agents-tools.test.mjs test/coevo-arena.test.mjs test/agents-coevo.test.mjs test/agents-coevo-regression.test.mjs test/coevo-report.test.mjs test/coevo-site.test.mjs",
    "test:inference": "node --test test/inference-onnx.test.mjs test/inference-api-example.test.mjs test/inference-ort.test.mjs",
    "test:physics": "node --test test/physics.test.mjs test/physics-api-example.test.mjs",
    "test:sky": "node test/environment-sky.test.mjs",
    "test:tod": "node test/environment-timeofday.test.mjs",
    "test:night": "node test/environment-night.test.mjs",
    "test:atmosphere": "node test/environment-atmosphere.test.mjs",
    "test:aerial": "node test/environment-aerial.test.mjs",
    "test:sky:gpu": "node test/environment-gpu/headless.mjs",
    "test:environment": "node test/environment-ibl.test.mjs && node test/environment-probes.test.mjs && node test/environment-sky.test.mjs && node test/environment-timeofday.test.mjs && node test/environment-night.test.mjs && node test/environment-atmosphere.test.mjs && node test/environment-aerial.test.mjs",
    "watch:lib": "node build.js && tsc --watch",
    "watch:test-ui": "esbuild test/javascript/index.js --bundle --outfile=dist-web-test/index.js --platform=browser --format=esm --sourcemap --watch",
    "dev": "concurrently \"npm run watch:lib\" \"npm run watch:test-ui\" \"npm run dev:serve\"",
    "preview": "npx serve dist-web-test",
    "spike:animated-models": "node test/gpu/run-harness.mjs test/spikes/animated-models/run.js __ANIM_SPIKE_RESULTS__",
    "spike:skinned-models": "node test/gpu/run-harness.mjs test/spikes/skinned-models/run.js __SKIN_SPIKE_RESULTS__",
    "spike:films": "node test/gpu/run-harness.mjs test/spikes/films/run.js __FILM_SPIKE_RESULTS__",
    "spike:film-browser": "node test/spikes/film-browser/run.mjs",
    "film": "node tools/film/film.mjs",
    "film:check": "node tools/film/check.mjs",
    "test:film": "node --test --test-timeout=120000 test/film.test.mjs test/film-guard.test.mjs test/coevo-film.test.mjs test/film-overlay.test.mjs test/film-burn.test.mjs test/film-browser.test.mjs",
    "test:film:browser": "node test/film-browser-gpu/run.mjs"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "mediabunny": "1.61.3",
    "onnxruntime-web": "1.29.0",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "webgpu": "0.6.1",
    "wgsl_reflect": "^1.5.0"
  },
  "peerDependencies": {
    "mediabunny": "^1.61.3",
    "onnxruntime-web": "^1.29.0"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  }
}
